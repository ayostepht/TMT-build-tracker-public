# TMT Build Tracker, hosted setup. Copy to .env for local runs, or set the same names in your
# host's secret store (Fly secrets, Railway variables, deploy/.env for Docker Compose).
# Never commit real values. Full walkthrough: docs/guides/hosting.md

# ---------------------------------------------------------------- Required
# Postgres connection string. Supabase: Project Settings > Database > Connection string, the
# "Session pooler" one (port 5432), with ?sslmode=require kept at the end.
# Local development: postgres://tmt:tmt@localhost:5432/tmt_dev (start it with scripts/dev-postgres.sh)
DATABASE_URL=

# Signs sessions. Generate with: openssl rand -hex 32  (32+ characters, not a placeholder).
# Changing it signs everyone out. Keep a copy in a password manager.
BETTER_AUTH_SECRET=

# The address people type, https, no trailing slash. Sign-in callbacks are built from it.
# PUBLIC_URL=https://tmt.example.com

# Comma-separated emails of site admins (kit and template admin). They must sign in with a
# provider that proves that email address.
# ADMIN_EMAILS=you@example.com

# Hosted mode: sign-in with providers only, finite per-account limits, no printers on private
# networks. Needs PUBLIC_URL, ADMIN_EMAILS, at least one provider below and a trusted proxy
# (TRUST_CLOUDFLARE or ADDRESS_HEADER).
# TMT_MODE=public

# ---------------------------------------------------------------- Sign-in providers
# Each provider needs both values. Callback URL to register with the provider:
#   <PUBLIC_URL>/api/auth/callback/google | github | discord
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# ---------------------------------------------------------------- Client address and proxies
# 1 only when EVERY request reaches the app through Cloudflare (Cloudflare Tunnel, or a firewall
# that admits Cloudflare ranges only). The client address for rate limits is then the
# CF-Connecting-IP header, and a request without it is refused on /api/auth/*. If the app can
# also be reached directly, anyone can forge that header: leave this off and use ADDRESS_HEADER.
# TRUST_CLOUDFLARE=1
# Without Cloudflare: the header your own proxy sets and overwrites (Fly: Fly-Client-IP;
# a generic proxy: X-Forwarded-For). Ignored when TRUST_CLOUDFLARE is on.
# ADDRESS_HEADER=Fly-Client-IP
# Proxies to skip from the right of X-Forwarded-For (digits only, default 1).
# XFF_DEPTH=1

# ---------------------------------------------------------------- Files and limits
# Directory for uploads (photos, 3MF files, converted models). In the image: /data, a volume.
# DATA_DIR=/data
# Largest 3MF in MB. The image sets 95 because Cloudflare's free plan refuses request bodies
# over 100 MB. Keep BODY_SIZE_LIMIT at least 1 MB above it (the image sets 100M).
# MAX_3MF_MB=95
# BODY_SIZE_LIMIT=100M
# Connections held to Postgres (default 10, max 100). Supabase free allows few: keep it low.
# DATABASE_POOL_MAX=10
# Free space (MB) the data volume must keep; uploads are refused below it.
# MIN_FREE_DISK_MB=2048
# Per-account limits (QUOTA_*) and the write rate limit (WRITE_RATE_PER_MIN, WRITE_RATE_BURST)
# have hosted defaults; see src/lib/server/config.ts for the full list.
# QUOTA_UPLOAD_MB_PER_USER=1024

# ---------------------------------------------------------------- Analytics (optional, cookieless)
# Off unless ANALYTICS_PROVIDER is set. Only the chosen provider's script loads, only page views
# are sent (no query strings; ids after /builds/, /teams/, /designs/, /gallery/ become :id; never
# /api or /invite), and nothing loads for browsers sending Do Not Track or Global Privacy Control.
# ANALYTICS_PROVIDER=plausible
#   plausible: the site name as registered in Plausible; script URL only for self-hosted Plausible
#   (it must serve the "manual" script variant).
# PLAUSIBLE_DOMAIN=tmt.example.com
# PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.manual.js
#   umami:
# UMAMI_WEBSITE_ID=
# UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
#   cloudflare: Web Analytics beacon token. It cannot hide ids, so it only runs on pages whose
#   address has none (home, terms, privacy and similar).
# CF_ANALYTICS_TOKEN=

# ---------------------------------------------------------------- Cloudflare Tunnel (Docker Compose only)
# TUNNEL_TOKEN=
# Optional local Postgres in deploy/docker-compose.yml
# POSTGRES_PASSWORD=

# ---------------------------------------------------------------- Other
# off = never download a kit pack at start (the one baked into the image is used).
# KITPACK_DOWNLOAD=off
# off = no background printer status connections.
# TMT_PRINTERS=off
